# Local default: connect the backend to Ollama running on the host.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Public-host alternative. Never commit a real key.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

ALLOW_MODEL_OVERRIDE=true
TENARAI_ADMIN_KEY=
TENARAI_CHAT_LIMIT_PER_MINUTE=30
TENARAI_API_URL=http://localhost:8000
